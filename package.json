{
  "name": "brocode-site",
  "version": "3.0.0",
  "private": true,
  "description": "Static, dependency-free generator for the BroCODE site and field guide (https://codingagent.in).",
  "type": "module",
  "license": "MIT",
  "homepage": "https://codingagent.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodesbyFebin/BroCode.git"
  },
  "engines": {
    "node": ">=20.19 <25",
    "npm": ">=10"
  },
  "scripts": {
    "build": "node build.mjs",
    "verify": "node scripts/verify.mjs",
    "serve": "node scripts/serve.mjs",
    "validate": "html-validate \"dist/**/*.html\"",
    "links": "linkinator dist --recurse --skip '^https?://(?!localhost)'",
    "check": "npm run build && npm run verify && npm run validate"
  },
  "devDependencies": {
    "html-validate": "10.17.0",
    "linkinator": "7.6.1"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  }
}
